# SEC EDGAR — required descriptive User-Agent (name + contact email)
SEC_USER_AGENT="GuidanceWatch/0.1 (research; you@example.com)"

# OpenRouter LLM — optional. Without a key, the app uses the deterministic /
# ScriptedProvider path (fixtures + regex extractor). Note: OpenRouter :free
# models still require an API key; they are unbilled, not keyless.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4.1-nano

# Persistence / cache paths (defaults shown)
GUIDANCE_WATCH_DB_PATH=./data/guidance_watch.db
GUIDANCE_WATCH_CACHE_DIR=./data/cache
GUIDANCE_WATCH_REPORTS_DIR=./reports

# Optional OpenTelemetry → Phoenix
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces
# OTEL_SERVICE_NAME=guidance-watch

# Optional live OpenRouter agent extraction (also requires OPENROUTER_API_KEY)
# GUIDANCE_WATCH_USE_LIVE_AGENT=1
