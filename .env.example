# SEC EDGAR — required descriptive User-Agent (name + contact email)
SEC_USER_AGENT="GuidanceWatch/0.1 (research; you@example.com)"

# OpenRouter LLM (needed only for live agent runs; not required for pytest -m "not live")
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# Persistence / cache paths (defaults shown)
GUIDANCE_WATCH_DB_PATH=./data/guidance_watch.db
GUIDANCE_WATCH_CACHE_DIR=./data/cache
GUIDANCE_WATCH_REPORTS_DIR=./reports

# Optional OpenTelemetry → Phoenix
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces
# OTEL_SERVICE_NAME=guidance-watch
